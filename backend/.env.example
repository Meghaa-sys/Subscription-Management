# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL on Neon: use the DIRECT connection string, not the pooled one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Used for CORS and for the links placed in emails
FRONTEND_URL=http://localhost:5173

# Email. Only read when DEBUG=False; with DEBUG=True emails print to the console.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Brightloop <no-reply@brightloop.test>
