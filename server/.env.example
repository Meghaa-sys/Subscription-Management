# Brightloop Software — Server Environment Configuration
PORT=5000

# ------------------------------------------------------------------------------
# PostgreSQL Connection (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# 1. Sign up / login at https://console.neon.tech
# 2. Create a project named "brightloop"
# 3. Copy the "Connection string" from the Dashboard (choose "node-postgres" or "pooled connection")
# 4. Paste it below as DATABASE_URL:
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Optional local PostgreSQL parameters (if not using Neon):
# ------------------------------------------------------------------------------
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/brightloop
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=brightloop
# PGUSER=postgres
# PGPASSWORD=postgres
