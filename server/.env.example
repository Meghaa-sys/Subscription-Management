# SubscriptIQ Server Environment Configuration
PORT=5000

# PostgreSQL Connection Configuration
# For local PostgreSQL or cloud PostgreSQL (Neon, Supabase, AWS RDS, Railway):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/subscriptiq

# Optional individual connection params:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=subscriptiq
# PGUSER=postgres
# PGPASSWORD=postgres
